<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Glintbox" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/glint_light_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Glintbox.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/glint_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Glintbox</item>
    </style>

</resources>
