    <string name="respect_title">Before you start</string>
    <string name="respect_point_affiliation">Glintbox is an independent app. It is not affiliated with, endorsed or sponsored by WhatsApp LLC or Meta Platforms, Inc.</string>
    <string name="respect_point_consent">Statuses belong to the people who posted them. Only save or re-share content with the owner\'s permission.</string>
    <string name="respect_point_local">Glintbox only reads statuses already downloaded to your phone. It can\'t see anything you haven\'t viewed.</string>
    <string name="respect_point_offline">Everything stays on your device. Nothing is uploaded, collected or tracked.</string>
    <string name="read_privacy_policy">Read the privacy policy</string>
