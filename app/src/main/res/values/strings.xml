    <string name="onboarding_access_desc">Grant access to the statuses folder of the apps you use. Glintbox can only see that folder.</string>
    <string name="onboarding_access_skip">You can also do this later from the Statuses tab or Settings.</string>
    <string name="onboarding_save_title">Where should we save?</string>
    <string name="onboarding_save_desc">By default statuses are saved to Internal storage/%1$s. You can pick any other folder at any time.</string>
    <string name="onboarding_save_note">Change this whenever you like in Settings → Storage.</string>

    <!-- About -->
    <string name="about_title">About Glintbox</string>
    <string name="about_what_title">What it does</string>
    <string name="about_what_body">Glintbox lets you view and keep copies of statuses that your messaging app has already downloaded to your phone, organise them in a beautiful gallery and share them with the apps you choose.</string>
    <string name="about_disclaimer_title">Disclaimer</string>
    <string name="about_disclaimer_body">Glintbox is an independent product. It is not affiliated with, associated with, authorised, endorsed by, or in any way officially connected to WhatsApp LLC, Meta Platforms, Inc., or any of their subsidiaries or affiliates. \"WhatsApp\" is a trademark of its respective owner and is used here only to describe compatibility.</string>
    <string name="about_content_title">Respect content owners</string>
    <string name="about_content_body">Statuses are created and owned by other people. Saving or re-sharing them without permission may violate their privacy or intellectual-property rights. You are responsible for how you use saved content. Glintbox does not host, upload or distribute any content.</string>
    <string name="about_how_title">How it works</string>
    <string name="about_how_body">When you view a status, your messaging app stores a temporary copy on your phone for about 24 hours. With your permission, Glintbox reads that folder and copies the files you choose into your save folder.</string>
    <string name="about_permissions_title">Permissions</string>
    <string name="about_permissions_body">Android 11 and newer: no storage permission at all — you grant access to specific folders through the system folder picker and can revoke it any time. Android 8–10: the standard storage permission. Glintbox has no internet permission.</string>

    <!-- Privacy -->
    <string name="privacy_title">Privacy policy</string>
    <string name="privacy_updated">Last updated 24 September 2026</string>
    <string name="privacy_summary_title">In short</string>
    <string name="privacy_summary_body">Glintbox does not collect, store, transmit or sell any personal data. The app has no internet access, no analytics, no advertising and no third-party trackers.</string>
    <string name="privacy_collect_title">Data we collect</string>
    <string name="privacy_collect_body">None. Your preferences (theme, folders you picked, toggles) are stored only on your device and are deleted when you uninstall the app.</string>
    <string name="privacy_access_title">Files on your device</string>
    <string name="privacy_access_body">With your permission Glintbox reads media files from the status folder you grant and writes copies to the save folder you choose. These files are processed entirely on your device and never leave it unless you explicitly share them with another app.</string>
    <string name="privacy_share_title">Sharing with third parties</string>
    <string name="privacy_share_body">Glintbox shares nothing with anyone. When you tap Share or Repost, Android hands the selected file to the app you pick; that app\'s own privacy policy applies.</string>
    <string name="privacy_children_title">Children</string>
    <string name="privacy_children_body">Glintbox is not directed at children under 13 and does not knowingly collect data from anyone.</string>
    <string name="privacy_changes_title">Changes</string>
    <string name="privacy_changes_body">If this policy changes, the updated version will be published in the app and on the store listing with a new date.</string>
    <string name="privacy_contact_title">Contact</string>
    <string name="privacy_contact_body">Questions? Email support@glintbox.app.</string>

